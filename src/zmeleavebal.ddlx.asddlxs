@Metadata.layer: #CORE

@UI.headerInfo: {
  typeName:       'Leave Balance',
  typeNamePlural: 'Leave Balance',
  typeImageUrl:   'sap-icon://time-off',
  title:       { type: #STANDARD, value: 'LeaveType' },
  description: { type: #STANDARD, value: 'LeaveTypeDescr' }
}
annotate entity ZCLEAVEBAL with
{
  @UI.facet: [
    {
        id: 'General',
        purpose: #STANDARD,
        type: #IDENTIFICATION_REFERENCE,
        label: 'Leave Balance Information',
        position: 10
    }
  ]

  EmpNo;

  @UI.lineItem: [
    {
        label: 'Year',
        position: 20
    }
  ]
  @UI.identification: [
    {
        label: 'Year',
        position: 20
    }
  ]
  @EndUserText.label: 'Year'
  Zyear;

  @UI.lineItem: [
    {
        label: 'Leave Type',
        position: 30
    }
  ]
  @UI.identification: [
    {
        label: 'Leave Type',
        position: 30
    }
  ]
  @Consumption:{
    valueHelpDefinition: [
        {
            entity:{
                name: 'ZILEAVETYP',
                element: 'LeaveType'
            },
            useForValidation: true
        }
    ]
  }
  @EndUserText.label: 'Leave Type'
  LeaveType;

//  @UI.lineItem: [
//    {
//        label: 'Leave Type Description',
//        position: 40
//    }
//  ]
//  @UI.identification: [
//    {
//        label: 'Leave Type Description',
//        position: 40
//    }
//  ]
//  LeaveTypeDescr;

  @UI.lineItem: [
    {
        label: 'Entitled Days',
        position: 50
    }
  ]
  @UI.identification: [
    {
        label: 'Entitled Days',
        position: 50
    }
  ]
  EntitledDays;

  @UI.lineItem: [
    {
        label: 'Used Days',
        position: 60
    }
  ]
  @UI.identification: [
    {
        label: 'Used Days',
        position: 60
    }
  ]
  UsedDays;

}