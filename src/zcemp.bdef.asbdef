projection;
strict ( 2 );
use draft;

define behavior for ZCEMP //alias <alias_name>
{
  use create;
  use update;

  use action Edit;
  use action Activate;
  use action Discard;
  use action Resume;
  use action Prepare;

  use association _leavebal { create; with draft; }
}

define behavior for ZCLEAVEBAL //alias <alias_name>
{
  use update;
  use delete;

  use association _emp { with draft; }
}